{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust Tweaker",
  "version": "1.0.0",
  "identifier": "com.rusttweaker.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rust Tweaker",
        "width": 1220,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
